# Copy this file to .env and fill in the keys for the providers you use
# (see config/settings.yaml for which providers are active). Never commit
# the real .env file.

# --- Content generation (required) ---
ANTHROPIC_API_KEY=

# --- Image generation: set the one matching providers.image in settings.yaml ---
# Gemini (default): free API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=
STABILITY_API_KEY=

# --- Narration: set the one matching providers.tts in settings.yaml ---
ELEVENLABS_API_KEY=
# GEMINI_API_KEY (above) is reused if providers.tts: gemini
# OPENAI_API_KEY (above) is reused if providers.tts: openai

# --- Optional: real web search grounding for the research stage.
# Without this the research agent still works, drawing on the LLM's own
# knowledge and naming its reference sources explicitly. ---
TAVILY_API_KEY=

# --- YouTube upload ---
# Path to the OAuth 2.0 client secret JSON downloaded from Google Cloud
# Console (APIs & Services > Credentials > OAuth client ID > Desktop app),
# with the YouTube Data API v3 enabled on that project.
YOUTUBE_CLIENT_SECRETS_FILE=
# Where the cached refresh token is written after the first interactive
# login (python -m yt_engine run ... will open a browser once).
YOUTUBE_TOKEN_FILE=.secrets/youtube_token.json
